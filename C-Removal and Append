#include<iostream>
#include<algorithm>
#include<vector>
using namespace std;
int main(){
    int n,q;
    cin>>n>>q;
    int pos[n+1];
    int ptr=n+1;
    for(int i=1;i<=n;i++){
        int curr;
        cin>>curr;
        pos[curr]=i;
    }
    while(q--){
        int querry;
        cin>>querry;
        pos[querry]=ptr++;
    }
    vector<pair<int,int>> list;
    for(int i=1;i<=n;i++){
        list.push_back(make_pair(pos[i],i));
        
    }
    sort(list.begin(),list.end());
    for(auto[pos,i]:list){
        cout<<i<<" ";
    }
    cout<<endl;
    
}
