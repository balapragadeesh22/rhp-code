import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.StringTokenizer;

public class Main {
    // DSU find with path compression
    private static int find(int[] ldr, int node) {
        if (ldr[node] != node) {
            ldr[node] = find(ldr, ldr[node]);
        }
        return ldr[node];
    }

    // DSU join with Union by Size
    private static void join(int[] ldr, int[] size, int rt, int lt) {
        int rootRt = find(ldr, rt);
        int rootLt = find(ldr, lt);
        
        if (rootRt != rootLt) {
            // Attach the smaller tree under the larger tree
            if (size[rootRt] < size[rootLt]) {
                ldr[rootRt] = rootLt;
                size[rootLt] += size[rootRt];
            } else {
                ldr[rootLt] = rootRt;
                size[rootRt] += size[rootLt];
            }
        }
    }

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st = new StringTokenizer(br.readLine());

        int N = Integer.parseInt(st.nextToken());
        int E = Integer.parseInt(st.nextToken());

        int[] ldr = new int[N + 1];
        int[] size = new int[N + 1];
        for (int node = 0; node <= N; node++) {
            ldr[node] = node;
            size[node] = 1;
        }

        int[] edges = new int[E + 1];
        for (int i = 1; i <= E; i++) {
            st = new StringTokenizer(br.readLine());
            int a = Integer.parseInt(st.nextToken());
            int b = Integer.parseInt(st.nextToken());
            edges[i] = a;
            join(ldr, size, a, b);
        }

        int[] gcnt = new int[N + 1];
        int[] ecnt = new int[N + 1];

        // Count members in each component
        for (int node = 1; node <= N; node++) {
            gcnt[find(ldr, node)]++;
        }

        // Count edges in each component
        for (int c = 1; c <= E; c++) {
            ecnt[find(ldr, edges[c])]++;
        }

        long ans = 0;
        for (int node = 1; node <= N; node++) {
            // Only process component leaders to avoid redundant math
            if (gcnt[node] > 0) {
                long curr = ((long) gcnt[node] * (gcnt[node] - 1) / 2) - ecnt[node];
                ans += curr;
            }
        }

        System.out.println(ans);
    }
}
