#include<iostream>
#include<vector>
#include<algorithm>
#include<map>
#include<set>
#include<queue>
#include<string>
#define ll long long int
 
using namespace std;
void solve(){
	int n;
	cin>>n;
	string s;
	cin>>s;
	int ans=-1;
	if(s[0]=='0'|| s.contains("00")){
		cout<<"-1"<<endl;
		return ;
	}
	if(s.contains("-+")||s.contains("+-")){
		if(s.contains("-++-")||s.contains("+--+")){
			ans=3;
		}
		else{
			ans=2;
		}
	}
	else{
		ans=1;
		for(int i=0;i<n;i+=2){
			if(s[i]=='0'){
				ans=2;
			}
			
		}
	}
	cout<<ans<<endl;
	
	return ;
}
 
 
int main(){
	ios_base::sync_with_stdio(false);
    cin.tie(NULL);
	int tc;
	cin>>tc;
	while(tc--){
		solve();
	}
	return 0;
}
