class Solution {
    public int minDistance(String word1, String word2) {
         int r=word1.length();
        int c=word2.length();
        int a[][]=new int[r+1][c+1];
        char[] arr1=word1.toCharArray();
        char[] arr2=word2.toCharArray();
        int maxi=0;
        for(int i=1;i<=r;i++){
            for(int j=1;j<=c;j++){
                if(arr1[i-1]==arr2[j-1]){
                    a[i][j]=1+a[i-1][j-1];
                   
                }
                else{
                    a[i][j]=Math.max(a[i-1][j],a[i][j-1]);
                   
                }
            }
        }
        maxi=a[r][c];
        return (r-maxi)+(c-maxi);
    }
}
