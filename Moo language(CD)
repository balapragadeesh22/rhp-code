#include<iostream>
#include<vector>
#include<algorithm>
#include<map>
#include<set>
#include<queue>
#define ll long long int

using namespace std;
int solve(){
	int n,m;
	cin>>n>>m;
	string s;
	cin>>s;
	int f=n/m;
	vector<bool>ar(f,false);
	for(int i=0;i<s.size();i++){
	    
	    if(s[i]=='0'){
	        int l=i/m;
	        ar[l]=true;
	    }
	    }
	    int count=0;
	    for(int j=0;j<f;j++){
	        if(!ar[j]){
	            count++;
	        }
	    }
	    cout<<count<<endl;
	
	return 0;
}







int main(){
	ios_base::sync_with_stdio(false);
    cin.tie(NULL);
	int tc;
	cin>>tc;
	while(tc--){
		solve();
	}
	return 0;
}
