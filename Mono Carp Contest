#include<iostream>
#include<vector>
#include<algorithm>
#include<map>
#include<set>
#include<queue>
#define ll long long int

using namespace std;
int solve(){
	int n;
	cin>>n;
	vector<int>arr(n);
	int onec=0;
	for(int i=0;i<n;i++){
		cin>>arr[i];
		onec+=arr[i];
	}
	int zeroc=n-onec;
	if(zeroc<2){
		cout<<"-1";
		return 0;
	}
	int c=0;
	int v=0;
	if(arr[0]!=0) c++;
	if(arr[n-1]!=0) v++;
	int z=c+v;
	cout<<z;
	
	return 0;
}







int main(){
	ios_base::sync_with_stdio(false);
    cin.tie(NULL);
	int tc;
	cin>>tc;
	while(tc--){
		solve();
		cout<<endl;
	}
	return 0;
}
