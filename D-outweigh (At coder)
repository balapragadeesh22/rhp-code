#include<iostream>
#include<vector>
#define ll long long int
using namespace std;
int main(){
  ll n;
  cin>>n;
  vector<ll>a(n);
  vector<ll>b(n);
  vector<ll>ans;
  ll ac=0;
  ll bc=0;
  for(int i=0;i<n;i++){ cin>>a[i];
  }
  for(int j=0;j<n;j++){ cin>>b[j];
  }
  for(int c=0;c<n;c++){
  	if(a[c]>b[c]){
  		 ac+=a[c]-b[c];

  	}
  	else {
  		 bc+=b[c]-a[c];
  	}
  	}
  	if(ac==0 ){
  		cout<<"No";
  		return 0;
  	}
  	ll z=(bc/ac)+2;
  	for(int t=0;t<n;t++){
  		if(a[t]>b[t]){
  			ans.push_back(z);
  		}
  		else{
  			ans.push_back(1);
  		}
  	}
  	cout<<"Yes"<<endl;
  	for(long long int k:ans){
  		cout<<k<<" ";
  	}
  	cout<<endl;
  	
  
 
  return 0;
}
