#include<iostream>
#include<vector>
#include<algorithm>
#include<map>
#include<set>
#include<queue>
#define ll long long int

using namespace std;
int solve(){
	ll n;
	cin>>n;
	vector<ll>a(n);
	vector<ll>b(n);
	vector<ll>ans;
	for(int i=0;i<n;i++){
		cin>>a[i];
	}
	for(int j=0;j<n;j++){
		cin>>b[j];
	}
	ll ad=0;
	ll bd=0;
	for(int k=0;k<n;k++){
		if(a[k]>b[k]){
			ad+=a[k]-b[k];
			
		}
		else{
			bd+=b[k]-a[k];
		
		
		}
	}
	if(ad ==0){
		cout<<"No"<<endl;
		return 0;
	}
	ll w=(bd/ad)+2;
	for(int i=0;i<n;i++){
	  if(a[i]>b[i]){
	    ans.push_back(w);
	  }
	  else{
	    ans.push_back(1);
	  }
	}
	
	cout<<"Yes"<<endl;
	for(long long int k:ans){
		cout<<k<<" ";
	}
	cout<<endl;
	
	
	return 0;
	
}


int main(){
	ios_base::sync_with_stdio(false);
    cin.tie(NULL);
	int tc=1;
	
	while(tc--){
		solve();
	}
	return 0;
}
