#include<iostream>
#include<vector>
#include<algorithm>
#include<map>
#define ll long long int

using namespace std;
int solve(){
	int n;
	cin>>n;
	map<int,int>ans;
	for(int i=0;i<n;i++){
		int x;
		cin>>x;
		ans[x]++;
		
	}
	int count=0;
	for(auto [key,val]:ans){
		if((val%2)==1){
			count++;
			
		}
	}
	cout<<count;
	
	
	
	return 0;
}



int main(){
	ios_base::sync_with_stdio(false);
    cin.tie(NULL);
	int tc=1;
	
	while(tc--){
		solve();
		
	}
	return 0;
}
